# ==============================================================================
# Cyber Attack Prediction & Early Warning System - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL / MySQL / SQLite)
# ------------------------------------------------------------------------------
# By default, if DATABASE_URL is not provided, the system uses SQLite automatically:
# sqlite:///data/cyber_threat.db

# To connect to PostgreSQL (Recommended for production):
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/cyber_threat
# Or individual parameters:
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=cyber_threat

# To connect to MySQL:
# DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/cyber_threat
# Or individual parameters:
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=cyber_threat

# ------------------------------------------------------------------------------
# 2. REST API & Server Configuration
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ------------------------------------------------------------------------------
# 3. Security & Admin Bootstrapping
# ------------------------------------------------------------------------------
SECRET_KEY=cyber-attack-detection-super-secret-key-2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecure2026!
